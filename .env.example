# Chave de segurança do Django (gere uma nova e mantenha em segredo)
DJANGO_SECRET_KEY="sua-chave-secreta-aqui"

# Em produção na biblioteca, sempre deixe como False
DJANGO_DEBUG=False

# Lista de IPs que podem acessar a tela de bater ponto (separados por vírgula)
# Sempre inclua o IP da própria máquina onde o servidor vai rodar.
ALLOWED_IPS=127.0.0.1,192.168.1.100

# ---------------------------------------------------------------------------
# Configurações de Sincronização em Nuvem (GitHub API)
# Se não preenchidos, o sistema roda normalmente, mas não atualiza a página pública.
# GITHUB_REPO ex: "eize-org/eize-ponto-historico"
# ---------------------------------------------------------------------------
GITHUB_TOKEN="ghp_sua_chave_aqui"
GITHUB_REPO="eize-org/eize-ponto-historico"
