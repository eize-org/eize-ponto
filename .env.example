# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ser commitado no Git.

# Chave secreta do Django — qualquer string longa e aleatória
DJANGO_SECRET_KEY=coloque-uma-chave-longa-e-aleatoria-aqui

# True apenas em desenvolvimento, False em produção
DJANGO_DEBUG=False

# IPs autorizados a acessar a tela de ponto e o admin (separados por vírgula, sem espaços)
ALLOWED_IPS=IP_DO_PC_1,IP_DO_PC_2

# ---------------------------------------------------------------------------
# Sincronização com a nuvem (PythonAnywhere)
# Deixe em branco para desativar a sincronização (ex: em desenvolvimento).
# SYNC_KEY deve ser IDÊNTICA ao valor de SYNC_KEY configurado no .env
# do projeto eize-ponto-api-historico (PythonAnywhere).
# ---------------------------------------------------------------------------
SYNC_URL=https://SEU_USUARIO.pythonanywhere.com
SYNC_KEY=
